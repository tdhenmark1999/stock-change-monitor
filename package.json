{
  "name": "stock-change-monitor",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter @esm/shared build && pnpm --filter @esm/api build && pnpm --filter @esm/web build",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "bash tests/run-integration.sh",
    "test:e2e": "bash tests/run-e2e.sh",
    "verify:persistence": "bash tests/verify-persistence.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "msgpackr-extract"
    ],
    "overrides": {
      "postcss": "^8.5.23",
      "multer": "^2.5.0",
      "deepmerge-ts": "^8.0.0"
    }
  }
}
