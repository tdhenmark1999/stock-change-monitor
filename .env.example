# Copy to .env and fill in the three secrets. Startup refuses to run while they are empty.
# Generate each one with: openssl rand -hex 24
POSTGRES_PASSWORD=
API_TOKEN=
ADMIN_USER=admin
ADMIN_PASSWORD=

# Web port. Keep 127.0.0.1 behind a reverse proxy, use 0.0.0.0 to expose it directly.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# Hostnames exempt from the private-address block. Set to "fixture" only for the local demo shop.
SSRF_ALLOW_HOSTS=

# Optional tuning, these are the defaults.
# CHECK_ATTEMPTS=3
# CHECK_TIMEOUT_MS=20000
# WORKER_CONCURRENCY=5
# SCHEDULER_TICK_MS=15000
# HISTORY_RETENTION_DAYS=90
