diff --git a/changedetectionio/store/datastore_guard.py b/changedetectionio/store/datastore_guard.py
new file mode 100644
index 00000000..d577b693
--- /dev/null
+++ b/changedetectionio/store/datastore_guard.py
@@ -0,0 +1,62 @@
+"""
+Startup checks that stop the datastore from silently losing saved data.
+
+- A datastore that is not a mounted volume is deleted with the container.
+- A datastore that cannot be written keeps edits in memory only, until the next restart.
+- A second process on one datastore overwrites watch.json from its own stale memory.
+"""
+
+import fcntl
+import os
+import sys
+import tempfile
+
+from loguru import logger
+
+from .. import strtobool
+
+LOCK_FILENAME = '.instance.lock'
+
+# Held for the life of the process, the kernel releases the lock when it exits.
+_lock_file = None
+
+
+def _running_in_container():
+    return os.path.exists('/.dockerenv') or os.path.exists('/run/.containerenv')
+
+
+def _is_mount_point(path):
+    target = os.path.realpath(path)
+    with open('/proc/self/mountinfo') as f:
+        return any(line.split()[4] == target for line in f)
+
+
+def _refuse(message):
+    logger.critical(f"DATASTORE GUARD: {message}")
+    sys.exit(3)
+
+
+def enforce_datastore_safety(datastore_path):
+    global _lock_file
+
+    if _running_in_container() and not strtobool(os.getenv('ALLOW_EPHEMERAL_DATASTORE', 'False')):
+        if not _is_mount_point(datastore_path):
+            _refuse(f"'{datastore_path}' is not a mounted volume, all data would be deleted with this container. "
+                    f"Mount a volume at '{datastore_path}' or set ALLOW_EPHEMERAL_DATASTORE=true.")
+
+    try:
+        with tempfile.NamedTemporaryFile(dir=datastore_path, prefix='.write-probe-') as probe:
+            probe.write(b'ok')
+            probe.flush()
+            os.fsync(probe.fileno())
+    except OSError as e:
+        _refuse(f"'{datastore_path}' is not writable, saved changes would be lost on restart: {e}")
+
+    _lock_file = open(os.path.join(datastore_path, LOCK_FILENAME), 'w')
+    try:
+        fcntl.flock(_lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except OSError:
+        _refuse(f"another instance is already using '{datastore_path}'. "
+                f"Two instances overwrite each other's saved changes, stop the other one first.")
+
+    logger.info(f"Datastore guard passed for '{datastore_path}'")
